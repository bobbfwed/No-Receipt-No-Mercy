{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(python -m pytest *)",
      "Bash(npm run *)",
      "WebFetch(domain:docs.inductiveautomation.com)",
      "WebFetch(domain:developer.wordpress.org)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(sqlcmd *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "additionalDirectories": [
      "../shared-libs/"
    ]
  }
}